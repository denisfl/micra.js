{
  "name": "micra.js",
  "version": "2.6.0",
  "description": "Lightweight reactive UI framework for server-rendered pages — reactive state, directives, event bus. < 7 KB gzip.",
  "type": "module",
  "main": "./dist/micra.cjs.js",
  "module": "./dist/micra.esm.js",
  "browser": "./dist/micra.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/micra.esm.js",
      "require": "./dist/micra.cjs.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "llms.txt",
    "llms-full.txt"
  ],
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests/tsconfig.json",
    "dev": "node build.mjs --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.7",
    "esbuild": "^0.28.0",
    "happy-dom": "^20.9.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.7"
  },
  "keywords": [
    "framework",
    "micra",
    "lightweight",
    "ssr",
    "reactive",
    "directives",
    "alpine-alternative"
  ],
  "author": "Denis Fedosov-Ledovskikh",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/denisfl/micra.js.git"
  },
  "homepage": "https://github.com/denisfl/micra.js#readme",
  "bugs": {
    "url": "https://github.com/denisfl/micra.js/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
